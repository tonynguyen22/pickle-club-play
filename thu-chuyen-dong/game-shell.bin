<!doctype html>
<html lang="vi">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#173e3d"><meta name="description" content="Pickleball Club"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"><meta name="apple-mobile-web-app-title" content="Pickle! Club"><link rel="manifest" href="./manifest.webmanifest"><link rel="icon" type="image/png" href="./app/icon-192.png"><link rel="apple-touch-icon" href="./app/apple-touch-icon.png"><title>Pickleball Club</title>
<style>.boot-screen{z-index:50;color:#eff0d4;background:#173e3d;flex-direction:column;justify-content:center;align-items:center;gap:18px;font:600 14px system-ui,sans-serif;display:flex;position:fixed;inset:0}.boot-screen img{width:88px;height:88px}.boot-screen [role=status]{opacity:.8}.boot-retry{color:#173e3d;font:inherit;background:#eff0d4;border:0;border-radius:12px;padding:12px 20px}.boot-screen[hidden],.boot-retry[hidden]{display:none}</style>  <script type="module" crossorigin src="./assets/game-DpfaoxGx.js"></script>
  <link rel="modulepreload" crossorigin href="./assets/preload-helper-Bv5dn2FP.js">
</head>
<body data-view="phone">
  <header class="preview-bar"><strong>Pickleball Club</strong><div class="view-switch"><button data-view="phone" data-label="Khung điện thoại" aria-label="Khung điện thoại" title="Khung điện thoại" aria-pressed="true"></button><button data-view="full" data-label="Mở rộng" aria-label="Mở rộng" title="Mở rộng" aria-pressed="false"></button></div></header>
  <main class="stage"><div class="device"><div id="game" class="game" data-screen="home" data-guide="false" data-dragging="false"><canvas id="court" tabindex="0" data-label="Sân pickleball 3D — vuốt để đánh, chạm bóng để block, chạm sân để di chuyển" aria-label="Sân pickleball 3D — vuốt để đánh, chạm bóng để block, chạm sân để di chuyển"></canvas><div class="hud"></div><div class="sheet-layer"></div><div class="toast" role="status"></div><div class="error" hidden><b data-copy="Chưa mở được sân 3D">Chưa mở được sân 3D</b><p data-copy="Thử tải lại trang để vào sân.">Thử tải lại trang để vào sân.</p><button data-copy="Tải lại" onclick="location.reload()">Tải lại</button></div></div></div></main>
  <div class="boot-screen"><img src="./app/icon-192.png" width="88" height="88" alt="Pickle! Club"><span role="status">Mở sân… / Loading…</span><button class="boot-retry" hidden onclick="location.reload()">Tải lại / Retry</button></div>
</body></html>

